        <mxCell id="note1" parent="1" style="text;html=0;align=left;verticalAlign=middle;fontColor=#18304a;fontSize=14;fontFamily=Comic Sans MS;" value="SensorCampaign composite key: (sensor_id, campaign_id)." vertex="1">
